        </mxCell>

        <!-- Legend / Notes Box -->
        <mxCell id="legend_box" value="&lt;b&gt;ERD Relationships Legend:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Categories ──&amp;lt; Products&lt;/b&gt; (1:N): One category contains many products.&lt;br&gt;• &lt;b&gt;Customers ──&amp;lt; Orders&lt;/b&gt; (1:N): One customer places multiple orders.&lt;br&gt;• &lt;b&gt;Orders ──&amp;lt; Order_Items&lt;/b&gt; (1:N): One order includes multiple line items.&lt;br&gt;• &lt;b&gt;Products ──&amp;lt; Order_Items&lt;/b&gt; (1:N): One product can appear in many order line items." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=middle;spacing=10;fontSize=11;fontColor=#475569;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="690" width="640" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
